[Unit]
Description=Genio OS — local-first AI studio (go.hitech.tn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=genio
Group=genio
# الإنتاج على سيرفر TN: الكود و البيانات في نفس المجلّد
WorkingDirectory=/data/genio-os
Environment=GENIO_DATA_DIR=/data/genio-os
# التوكن من ملف محمي (chmod 600)، ماشي من سطر الأوامر
EnvironmentFile=-/etc/genio-os/genio.env
ExecStart=/data/genio-os/venv/bin/python -m uvicorn web.server:app --host 127.0.0.1 --port 8099 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
